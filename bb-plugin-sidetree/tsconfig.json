{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false
  },
  "include": [
    "server.ts",
    "app.tsx",
    "opener.tsx",
    "code-editor.tsx",
    "markdown-editor.tsx",
    "quote-selection.ts",
    "file-sync.ts",
    "selection-add-to-chat.tsx",
    "source-renderer.tsx",
    "scroll-fade.tsx",
    "tab-icon.ts",
    "file-icon.tsx",
    "editor-language.ts",
    "editor-theme.ts",
    "tree.ts",
    "file-icon.tsx",
    "components",
    "lib",
    "hooks"
  ]
}
