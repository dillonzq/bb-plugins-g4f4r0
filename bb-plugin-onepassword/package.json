{
  "name": "bb-plugin-onepassword",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.87"
  },
  "bb": {
    "name": "1Password",
    "description": "Use 1Password credentials in remote BB with passkey approvals and a separately hosted protected worker. Community integration.",
    "branding": {
      "icon": "Lock"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.87",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "5.0.0"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit && npm run check --prefix service",
    "test:unit": "vitest run tests",
    "test": "npm run test:unit",
    "test:e2e": "playwright test",
    "build:service": "npm run build --prefix service",
    "check": "npm run typecheck && npm run test:unit && npm run build:service",
    "test:demo": "playwright test --config playwright.demo.config.ts"
  }
}
